# CareBridge Environment Variables
# Copy this file to .env and configure your keys for production or backend testing.

# 1. Supabase Backend Settings (Optional for frontend mock/offline mode)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Maps Integration (Optional - OpenStreetMap fallback is enabled by default)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key_if_used

# 3. Notification Service
VITE_NOTIFICATION_PROVIDER=browser_demo
